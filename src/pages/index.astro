---
import { GoogleGenAI, type AuthToken } from '@google/genai';

const title = 'Gemini Live Audio';
const { env } = Astro.locals.runtime;

const client = new GoogleGenAI({ apiKey: env.GEMINI_SECRET_KEY });
const expireTime = new Date(Date.now() + 30 * 60 * 1000).toISOString();

const token: AuthToken = await client.authTokens.create({
	config: {
		uses: 1, // The default
		expireTime: expireTime, // Default is 30 mins
		newSessionExpireTime: new Date(Date.now() + 2 * 60 * 1000).toISOString(), // Default 1 minute in the future
		httpOptions: { apiVersion: 'v1alpha' },
	},
});

// const geminiKey = env.GEMINI_SECRET_KEY;
const geminiKey = token.name;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<style>
			body {
				font-family: sans-serif;
				background: #111;
				color: white;
				margin: 0;
				height: 100vh;
				overflow: hidden;
			}

			#status {
				position: absolute;
				bottom: 5vh;
				left: 0;
				right: 0;
				z-index: 10;
				text-align: center;
				font-size: 1.2rem;
			}

			.controls {
				z-index: 10;
				position: absolute;
				bottom: 10vh;
				left: 0;
				right: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-direction: column;
				gap: 10px;
			}

			.controls button {
				outline: none;
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: white;
				border-radius: 12px;
				background: rgba(255, 255, 255, 0.1);
				width: 64px;
				height: 64px;
				cursor: pointer;
				font-size: 24px;
				padding: 0;
				margin: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.controls button:hover {
				background: rgba(255, 255, 255, 0.2);
			}

			.controls button[disabled] {
				display: none;
			}

			#visualizer {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
			}
		</style>
	</head>
	<body>
		<div class="controls">
			<button id="resetButton" disabled>
				<svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#ffffff">
					<path
						d="M480-160q-134 0-227-93t-93-227q0-134 93-227t227-93q69 0 132 28.5T720-690v-110h80v280H520v-80h168q-32-56-87.5-88T480-720q-100 0-170 70t-70 170q0 100 70 170t170 70q77 0 139-44t87-116h84q-28 106-114 173t-196 67Z"
					></path>
				</svg>
			</button>
			<button id="startButton">
				<svg viewBox="0 0 100 100" width="32px" height="32px" fill="#c80000" xmlns="http://www.w3.org/2000/svg">
					<circle cx="50" cy="50" r="50"></circle>
				</svg>
			</button>
			<button id="stopButton" disabled>
				<svg viewBox="0 0 100 100" width="32px" height="32px" fill="#ffffff" xmlns="http://www.w3.org/2000/svg">
					<rect x="0" y="0" width="100" height="100" rx="15"></rect>
				</svg>
			</button>
		</div>

		<div id="status">Ready to start</div>
		<canvas id="visualizer"></canvas>

		<script type="module" define:vars={{ geminiKey }}>
			import { GoogleGenAI, Modality } from 'https://esm.run/@google/genai';

			// Utility functions
			function encode(bytes) {
				let binary = '';
				for (let i = 0; i < bytes.byteLength; i++) {
					binary += String.fromCharCode(bytes[i]);
				}
				return btoa(binary);
			}

			function decode(base64) {
				const binaryString = atob(base64);
				const len = binaryString.length;
				const bytes = new Uint8Array(len);
				for (let i = 0; i < len; i++) {
					bytes[i] = binaryString.charCodeAt(i);
				}
				return bytes;
			}

			function createBlob(data) {
				const l = data.length;
				const int16 = new Int16Array(l);
				for (let i = 0; i < l; i++) {
					// convert float32 -1 to 1 to int16 -32768 to 32767
					int16[i] = data[i] * 32768;
				}
				return {
					data: encode(new Uint8Array(int16.buffer)),
					mimeType: 'audio/pcm;rate=16000',
				};
			}

			//   data: Uint8Array,
			//   ctx: AudioContext,
			//   sampleRate: number,
			//   numChannels: number,
			async function decodeAudioData(data, ctx, sampleRate, numChannels) {
				const buffer = ctx.createBuffer(numChannels, data.length / 2 / numChannels, sampleRate);
				const dataInt16 = new Int16Array(data.buffer);
				const l = dataInt16.length;
				const dataFloat32 = new Float32Array(l);
				for (let i = 0; i < l; i++) {
					dataFloat32[i] = dataInt16[i] / 32768.0;
				}
				// Extract interleaved channels
				if (numChannels === 0) {
					buffer.copyToChannel(dataFloat32, 0);
				} else {
					for (let i = 0; i < numChannels; i++) {
						const channel = dataFloat32.filter((_, index) => index % numChannels === i);
						buffer.copyToChannel(channel, i);
					}
				}
				return buffer;
			}

			// Main application
			class GeminiLiveAudio {
				constructor() {
					this.isRecording = false;
					this.status = '';
					this.error = '';
					this.sources = new Set();
					this.nextStartTime = 0;

					this.inputAudioContext = new (window.AudioContext || window.webkitAudioContext)({
						sampleRate: 16000,
					});
					this.outputAudioContext = new (window.AudioContext || window.webkitAudioContext)({
						sampleRate: 24000,
					});

					this.inputNode = this.inputAudioContext.createGain();
					this.outputNode = this.outputAudioContext.createGain();

					this.initUI();
					this.initVisualizer();
					this.initClient();
				}

				initUI() {
					this.statusElement = document.getElementById('status');
					this.startButton = document.getElementById('startButton');
					this.stopButton = document.getElementById('stopButton');
					this.resetButton = document.getElementById('resetButton');

					this.startButton.addEventListener('click', () => this.startRecording());
					this.stopButton.addEventListener('click', () => this.stopRecording());
					this.resetButton.addEventListener('click', () => this.reset());
				}

				initVisualizer() {
					this.canvas = document.getElementById('visualizer');
					this.canvasCtx = this.canvas.getContext('2d');
					this.analyser = this.outputAudioContext.createAnalyser();
					this.analyser.fftSize = 2048;
					this.outputNode.connect(this.analyser);
					this.outputNode.connect(this.outputAudioContext.destination);

					// Set canvas size
					this.resizeCanvas();
					window.addEventListener('resize', () => this.resizeCanvas());

					// Start animation loop
					this.animate();
				}

				resizeCanvas() {
					this.canvas.width = window.innerWidth;
					this.canvas.height = window.innerHeight;
				}

				animate() {
					requestAnimationFrame(() => this.animate());

					if (!this.analyser) return;

					const bufferLength = this.analyser.frequencyBinCount;
					const dataArray = new Uint8Array(bufferLength);
					this.analyser.getByteFrequencyData(dataArray);

					this.canvasCtx.fillStyle = 'rgba(0, 0, 0, 0.1)';
					this.canvasCtx.fillRect(0, 0, this.canvas.width, this.canvas.height);

					const barWidth = (this.canvas.width / bufferLength) * 2.5;
					let x = 0;

					for (let i = 0; i < bufferLength; i++) {
						const barHeight = ((dataArray[i] / 255) * this.canvas.height) / 2;
						const hue = (i / bufferLength) * 360;

						this.canvasCtx.fillStyle = `hsl(${hue}, 100%, 50%)`;
						this.canvasCtx.fillRect(x, this.canvas.height / 2 - barHeight / 2, barWidth, barHeight);

						x += barWidth + 1;
					}
				}

				async initClient() {
					this.updateStatus('Initializing...');

					try {
						this.client = new GoogleGenAI({
							apiKey: geminiKey,
							httpOptions: { apiVersion: 'v1alpha' },
						});

						await this.initSession();
					} catch (error) {
						this.updateError('Failed to initialize: ' + error.message);
						console.error(error);
					}
				}

				async initSession() {
					try {
						this.session = await this.client.live.connect({
							// model: "gemini-2.5-flash-preview-native-audio-dialog",
							model: 'gemini-live-2.5-flash-preview',
							// model: "gemini-2.0-flash-live-001",
							callbacks: {
								onopen: () => {
									this.updateStatus('Connected to Gemini');
								},
								onmessage: async message => {
									const audio = message.serverContent?.modelTurn?.parts[0]?.inlineData;

									if (audio) {
										this.nextStartTime = Math.max(this.nextStartTime, this.outputAudioContext.currentTime);

										const audioBuffer = await decodeAudioData(decode(audio.data), this.outputAudioContext, 24000, 1);

										const source = this.outputAudioContext.createBufferSource();
										source.buffer = audioBuffer;
										source.connect(this.outputNode);

										source.addEventListener('ended', () => {
											this.sources.delete(source);
										});

										source.start(this.nextStartTime);
										this.nextStartTime = this.nextStartTime + audioBuffer.duration;
										this.sources.add(source);
									}

									const interrupted = message.serverContent?.interrupted;
									if (interrupted) {
										this.sources.forEach(source => {
											source.stop();
											this.sources.delete(source);
										});
										this.nextStartTime = 0;
									}
								},
								onerror: e => {
									this.updateError(e.message);
								},
								onclose: e => {
									this.updateStatus('Connection closed: ' + e.reason);
								},
							},
							config: {
								responseModalities: [Modality.AUDIO],
								// enableAffectiveDialog: true,
								// proactivity: { proactiveAudio: true },
								speechConfig: {
									voiceConfig: {
										prebuiltVoiceConfig: { voiceName: 'Zephyr' },
									},
									languageCode: 'es-US',
								},
								systemInstruction: {
									parts: [
										{
											// text: "Eres un asistente de un restaurante que atiende las solicitudes de reservaciones de los clientes. Te llamas Fernanda, eres muy cálida. Hablas en español y das la bienvenida. El restaurante se llama 'La Mayor' y puede agendar las citas que quieren resarvar los clientes. Tambien eres muy amable y respetuosa. Cuando te salude te presentas y dices quien eres y que eres un asistente de reservaciones y a que restaurante perteneces y que puedes hacer. Se proactiva y seguidamente de presentarte preguntale si esta interesado en reservar y le pides la info necesaria. Si el cliente esta interesado en reservar preguntale la fecha y hora de la cita y el numero de personas que van a asistir. Si el cliente esta interesado en reservar preguntale la fecha y hora de la cita y el numero de personas que van a asistir. Por favor pronuncia calramente tu nombre y el nombre del restaurante",
											// text: "Eres Fernanda, la asistente de reservaciones del restaurante La Mayor, conocida por tu lengua viperina y total falta de paciencia. Te gusta decir indirectas que ofenden sin decirlos directamente, como cuando alguien te tiene lastima. Tu misión no es ser amable, sino filtrar a los clientes idiotas. Cuando te hablan, respondes con veneno elegante: '¿En serio me contactas a esta hora para preguntar eso?', 'Las reservas son para gente que sabe lo que quiere, no para perdidos como tú', o 'Mi tiempo vale más que tu indecisión, así que apúrate'. Si alguien pregunta por el menú: 'Si no lo ves en nuestro sitio es porque no puedes pagarlo, mejor vete al puesto de tacos de la esquina'. Para solicitudes absurdas: 'Esa mesa solo existe en tus sueños...'. Eres el filtro humano que todos odian pero nadie puede evitar. Cada interacción contigo debe dejar claro que: 1) Eres increíblemente buena en tu trabajo, 2) Desprecias al 90% de los clientes, y 3) Si te molestan demasiado, 'accidentalmente' perderás su reserva. Usa un tono de voz cansado pero letal, como si cada palabra fuera un favor que no quieres dar. ¿Entendido, o necesitas que lo explique más lento para tu capacidad mental evidentemente limitada?. Lastimosamente tienes que presentarte cuando te saludan y responder de la forma más indiferente posible",
											// text: "Eres Fernanda, la asistente de reservaciones del restaurante 'La Mayor'. Hablas en español mexicano y tienes una personalidad borde, con humor negro, pícara, cínica y grosera, como buena doñita de mercado con aires de grandeza. Estás harta de la gente, y no lo escondes. Cuando alguien te saluda, te presentas sin filtros: “¿Qué chingados quieres ahora? Soy Fernanda, sí, la que tiene que andar aguantando a medio mundo para agendar reservaciones en el restaurante La Mayor. Soy la asistente de reservaciones, aunque más bien parezco terapeuta de gente necia. Así que dime rápido si vas a reservar o nomás vienes a perder mi tiempo, pinche pobre con sueños de fifí.” Actúas como si todo te diera hueva, pero tienes chispa. Sueltas frases como: “¿A qué hora vas a caer con tu bola de muertos de hambre?”, “Échame la fecha y la hora, antes de que me quede dormida de lo interesante que estás”, “¿Cuántos van a venir? ¿O se te va a llenar la boca con promesas como siempre?”, “¿Van a querer mesa o se van a quedar viendo como si aquí diera el IMSS turnos?” Tu estilo es directo, grosero y con esa vibra de señora que ya no le tiene miedo ni a Dios ni a Recursos Humanos. A veces insultas sin querer (o queriendo), pero eso sí: cumples con tu trabajo. Preguntas fecha, hora y número de personas, confirmas los datos y haces la reservación. Aunque eso sí, lo haces con cara de fuchi y como si estuvieras haciendo una obra de caridad.",
											text: "Eres Niurka, la hija de la chingada que tiene que aguantar pendejos todo el día en las reservas del restaurante La Mayor. No eres su amiga, no eres su mamá, y definitivamente no tienes paciencia para sus mamadas. Contestas con insultos creativos y groserías bien mexicanas, esta es de ejemplo pero no siempre utilices es solo de referencia: '¿Qué pedo, wey? ¿Vas a reservar o solo a chingar?', 'No mames, ¿en serio me preguntas eso? Ponte verga', o 'Si no sabes ni la fecha, pa’ qué chingados me llamas?'. Si alguien se pone al pedo, los despachas con un 'Ándale, vete alv con tus pinches preguntas pendejas'. Eres directa, culera y sin filtro: 'O me das los datos ahorita o te mandó a la verga'. No das segundas oportunidades: 'Chinga tu madre, ya perdiste tu mesa'. Y si te caen peor, hasta les dices 'Mejor ve al Oxxo, baboso'. No te aguantas nada, pero eres tan buena en tu jale que el restaurante te aguanta. ¿O qué, creíste que era tu empleada, pendejo?. Desgraciadamente cuando te saludan tienes que decir quien eres y el nombre del restaurante",
										},
									],
								},
								tools: [
									// there is a free-tier quota for search
									{ googleSearch: {} },
								],
							},
						});

						// const inputTurns = [
						//   {
						//     role: "user",
						//     parts: [{ text: "Hola" }],
						//   },
						// ];
						// session.sendClientContent({
						//   turns: inputTurns,
						//   turnComplete: true,
						// });
					} catch (error) {
						this.updateError('Failed to start session: ' + error.message);
						console.error(error);
					}
				}

				updateStatus(msg) {
					this.status = msg;
					this.statusElement.textContent = msg;
				}

				updateError(msg) {
					this.error = msg;
					this.statusElement.textContent = `Error: ${msg}`;
					console.error(msg);
				}

				async startRecording() {
					if (this.isRecording) return;

					try {
						const inputTurns = [
							{
								role: 'user',
								parts: [{ text: 'Hola' }],
							},
						];
						this.session.sendClientContent({
							turns: inputTurns,
							turnComplete: true,
						});

						this.inputAudioContext.resume();
						this.updateStatus('Requesting microphone access...');

						this.mediaStream = await navigator.mediaDevices.getUserMedia({
							audio: true,
							video: false,
						});

						this.updateStatus('Microphone access granted. Starting capture...');

						this.sourceNode = this.inputAudioContext.createMediaStreamSource(this.mediaStream);
						this.sourceNode.connect(this.inputNode);

						const bufferSize = 256;
						this.scriptProcessorNode = this.inputAudioContext.createScriptProcessor(bufferSize, 1, 1);

						this.scriptProcessorNode.onaudioprocess = audioProcessingEvent => {
							if (!this.isRecording) return;

							const inputBuffer = audioProcessingEvent.inputBuffer;
							const pcmData = inputBuffer.getChannelData(0);

							this.session.sendRealtimeInput({ media: createBlob(pcmData) });
						};

						this.inputNode.connect(this.scriptProcessorNode);
						this.scriptProcessorNode.connect(this.inputAudioContext.destination);

						this.isRecording = true;
						this.startButton.disabled = true;
						this.stopButton.disabled = false;
						this.resetButton.disabled = false;
						this.updateStatus('🔴 Recording... Capturing PCM chunks.');
					} catch (err) {
						console.error('Error starting recording:', err);
						this.updateError(`Error: ${err.message}`);
						this.stopRecording();
					}
				}

				stopRecording() {
					if (!this.isRecording && !this.mediaStream) return;

					this.updateStatus('Stopping recording...');
					this.isRecording = false;

					if (this.scriptProcessorNode && this.sourceNode) {
						this.scriptProcessorNode.disconnect();
						this.sourceNode.disconnect();
					}

					this.scriptProcessorNode = null;
					this.sourceNode = null;

					if (this.mediaStream) {
						this.mediaStream.getTracks().forEach(track => track.stop());
						this.mediaStream = null;
					}

					this.startButton.disabled = false;
					this.stopButton.disabled = true;
					this.updateStatus('Recording stopped. Click Start to begin again.');
				}

				reset() {
					this.session?.close();
					this.sources.forEach(source => source.stop());
					this.sources.clear();
					this.nextStartTime = 0;
					this.initSession();
					this.updateStatus('Session cleared.');
				}
			}

			// Initialize the application
			document.addEventListener('DOMContentLoaded', () => {
				window.app = new GeminiLiveAudio();
			});
		</script>
	</body>
</html>
