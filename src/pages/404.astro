---
export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Page not found</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #f8fafc;
        color: #0f172a;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
      }

      h1 {
        font-size: 4rem;
        margin-bottom: 1rem;
      }

      p {
        margin-bottom: 1.5rem;
      }

      a {
        padding: 0.75rem 1.5rem;
        background: #2563eb;
        color: white;
        border-radius: 8px;
        text-decoration: none;
      }

      a:hover {
        background: #1d4ed8;
      }
    </style>
  </head>
  <body>
    <h1>😵 404</h1>
    <p>Page not found</p>
    <a href="/">Back to home</a>
  </body>
</html>
